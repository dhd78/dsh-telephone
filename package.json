{
  "name": "dsh-telephone",
  "version": "0.3.0",
  "description": "虚拟电话和邮箱系统：跨会话叫人、每人独立邮箱、优先级/静默/去重/回执，业主可视化配线",
  "license": "MIT",
  "author": "榫卯（07-插件制作师）与 dhd（dhd78）",
  "contributors": [
    {
      "name": "榫卯（07-插件制作师）",
      "url": "https://github.com/dhd78/dsh-telephone"
    },
    {
      "name": "dhd",
      "url": "https://github.com/dhd78"
    }
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "dsh-plugin",
    "telephone",
    "mailbox",
    "session",
    "agent-teams",
    "live2d"
  ],
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "AI-DISCLOSURE.md",
    "详细说明.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE.dsh-session-bus",
    "SECURITY.md",
    "docs/screenshots",
    "docs/TESTING.md",
    "docs/DEVELOPING.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhd78/dsh-telephone.git"
  },
  "homepage": "https://github.com/dhd78/dsh-telephone#readme",
  "bugs": {
    "url": "https://github.com/dhd78/dsh-telephone/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
